<application>
    <name>CARLsimCNS_CARLhelm E-Puck2 5541 (GUI, CAM)</name>
    <description>CARLhelm - Control E-Puck2 by X3D with GUI and CAM</description>
    <version>1.0</version>
       
    <module>
        <name>yarpview</name>
 		<workdir>CARLsimGUI</workdir>
        <node>/win-yarp</node>      
        <prefix></prefix>
    </module> 
              
	<module>
        <name>yarpdev.exe</name>
        <parameters>--device JoypadControlServer --use_separate_ports 1 --name /X3D/joypad --subdevice SDLJoypad --profile --from SDLJoypad.ini --context T</parameters>     
        <node>localhost</node>
    </module>

                    
    <module>
        <name>CarlEpuck2</name>
        <parameters>--log info --from CarlEpuck2_basic.ini --context T</parameters>
        <node>/win-yarp</node>      
        <prefix></prefix>
    </module>         
         
    <module>
        <name>yarpdev.exe</name>
        <parameters>--device CarlController --remote /X3D/joypad --local /carlctrl</parameters>
        <node>localhost</node>
    </module>    


    <connection persist="true">
        <from>/e-puck2/cam</from>
        <to>/yarpview/img:i</to>
        <protocol>tcp</protocol>
    </connection>


    <module>
        <name>carlsimgui</name>
        <parameters>unittest17_epuck_sensory_cortex.config</parameters> 
        <workdir>CARLsimGUI</workdir>
        <node>/win-gpu</node>
    </module>
       
    <connection persist="false">
        <from>/e-puck2/sensors</from>
        <to>/cns/inbound/e-puck2/tof</to>
        <protocol>tcp</protocol>
    </connection>

    <connection persist="false">
        <from>/e-puck2/sensors</from>
        <to>/cns/inbound/e-puck2/ps</to>
        <protocol>tcp</protocol>
    </connection>

    <connection persist="false">
        <from>/cns/outbounde-puck2</from>              
        <to>/e-puck2/actuators</to>
        <protocol>tcp</protocol>
    </connection>


</application>
