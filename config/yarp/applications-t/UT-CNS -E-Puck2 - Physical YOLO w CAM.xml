<application>
    <name>CARLsimCNS_E-Puck2 5541 (YOLO/CAM)</name>
    <description>CARLsimGUI - Physical E-Puck2 with YOLO/CAM</description>
    <version>1.0</version>
       
	<!-- monitor cam input from E-Puck need to be started externally for conda   define a conda node ???
    <module>
        <name>yarpview</name>
		<parameters> -- port -- cam input 
 		<workdir>CARLsimGUI</workdir>
        <node>/win-yarp</node>      
        <prefix></prefix>
    </module> 
	-->   

	<!-- Monitor YOLO from need to be started externally for conda   define a conda node ???
    <module>
        <name>yarpview</name>
		<parameters> -- port -- yolo images
 		<workdir>CARLsimGUI</workdir>
        <node>/win-yarp</node>      
        <prefix></prefix>
    </module> 
	-->                                

    <module>
        <name>CarlEpuck2</name>
        <parameters>--log info --from CarlEpuck2_basic.ini --context T</parameters>
        <node>/win-yarp</node>      
        <prefix></prefix>
    </module>         
         

	<!-- connect Monitor to received images  or processed 
    -->
	<connection persist="true">
        <from>/e-puck2/cam</from>
        <to>/yarpview/img:i</to>
        <protocol>tcp</protocol>
    </connection>
	
	<!-- connect Monitor to received framed pics
    <connection persist="true">
        <from>/e-puck2/cam</from>
        <to>/yarpview/img:m</to>
        <protocol>tcp</protocol>
    </connection>
	-->

	<!-- module  YOLO   ISSUE Python, Conda -->
    <connection persist="true">
        <from>/e-puck2/cam</from>
        <to>/akidayolo/img:i</to>
        <protocol>tcp</protocol>
    </connection> 

 

    <module>
        <name>carlsimgui</name>
        <parameters>unittest20_epuck_sensory_cortex.config</parameters> 
        <workdir>CARLsimGUI</workdir>
        <node>/win-gpu</node>
    </module>
       

    <connection persist="false">
        <from>/e-puck2/sensors</from>
        <to>/cns/inbound/e-puck2/tof</to>
        <protocol>tcp</protocol>
    </connection>

    <connection persist="false">
        <from>/e-puck2/sensors</from>
        <to>/cns/inbound/e-puck2/ps</to>
        <protocol>tcp</protocol>
    </connection>

    <connection persist="false">
        <from>/akd/yolo:o</from>
        <to>/cns/inbound/yolo</to>
        <protocol>tcp</protocol>
    </connection>


    <connection persist="false">
        <from>/cns/outbounde-puck2</from>              
        <to>/e-puck2/actuators</to>
        <protocol>tcp</protocol>
    </connection>


</application>
