<?xml version="1.0" encoding="utf-8"?>

<CARLsimCNS>     
    
  <InboundChannel name="WbSensor Inbound Channel">
    <Properties>
      <Property name="Sensor Prefix">tof</Property>              
      <Property name="Neuron Height" type="int">2</Property>
      <Property name="Sensor Lifespan" type="int">32</Property>             
      <Property name="Backend" type="int">0</Property> 
      <Property name="Peak Current" type="double">40</Property>
      <Property name="Constant Current" type="double">0</Property>
      <Property name="Spikes Log">../../var/log/SpikeStream_Unittest20_tof_Spikes.log</Property> 
    </Properties>
    <Reader name="Yarp WbSensor Reader" type="WbSensor Reader">
      <Properties>      
        <Property name="Yarp Reading Port">/cns/inbound/e-puck2/tof</Property>      
        <Property name="Yarp Writing Port">/e-puck2/sensors</Property>      
        <Property name="Yarp RPC Server Port">/e-puck2/supervisor</Property>      
        <Property name="Yarp RPC Client Port">/cns/client/epuck2/tof</Property>      
        <Property name="Yarp Log">../../var/log/SpikeStream_Unittest20_tof_Yarp.log</Property>      
        <Property name="Buffer Log">../../var/log/SpikeStream_Unittest20_tof_Buffer.log</Property>
      </Properties>
    </Reader>
    <NeuronGroup name="ctx.tof"/>
  </InboundChannel>    
    
  <InboundChannel name="WbSensor Inbound Channel">
    <Properties>
      <Property name="Sensor Prefix">ps</Property>              
      <Property name="Neuron Height" type="int">1</Property>
      <Property name="Sensor Lifespan" type="int">32</Property>      
      <Property name="Backend" type="int">0</Property> 
      <Property name="Peak Current" type="double">60</Property>
       
      <Property name="Constant Current" type="double">0</Property>
      <Property name="Spikes Log">../../var/log/SpikeStream_Unittest20_ps_Spikes.log</Property> 
    </Properties>
    <Reader name="Yarp WbSensor Reader" type="WbSensor Reader">
      <Properties>      
        <Property name="Yarp Reading Port">/cns/inbound/e-puck2/ps</Property>      
        <Property name="Yarp Writing Port">/e-puck2/sensors</Property>      
        <Property name="Yarp RPC Server Port">/e-puck2/supervisor</Property>      
        <Property name="Yarp RPC Client Port">/cns/client/epuck2/ps</Property>      
        <Property name="Yarp Log">../../var/log/SpikeStream_Unittest20_ps_Yarp.log</Property>      
        <Property name="Buffer Log">../../var/log/SpikeStream_Unittest20_ps_Buffer.log</Property>
      </Properties>
    </Reader>
    <NeuronGroup name="ctx.ps"/>
  </InboundChannel>  
  

  <InboundChannel name="Yolo Inbound Channel">
    <Properties>          
      <Property name="Neuron Height" type="int">2</Property>
      <Property name="Probability Min">0.5;</Property>      
      <Property name="Probability Max">1.00;</Property>  
      <Property name="Direction Min">0.25;</Property>      
      <Property name="Direction Max">0.99;</Property>  
      <Property name="Distance Min">0.01;</Property>      
      <Property name="Distance Max">0.10;</Property>   
      <Property name="Class Min" type="int">6</Property>      
      <Property name="Class Max" type="int">6</Property>      
      <Property name="Yolo Lifespan" type="int">64</Property>      
      <Property name="Backend" type="int">0</Property> 
      <Property name="Peak Current" type="double">80</Property>
      <Property name="Standard Deviation" type="double">0.45</Property>       
      <Property name="Constant Current" type="double">0</Property>
      <Property name="Spikes Log">../../var/log/SpikeStream_Unittest20_yolo_Spikes.log</Property> 
    </Properties>
    <Reader name="Yarp Yolo Reader" type="Yolo Reader">
      <Properties>      
        <Property name="Yarp Reading Port">/cns/inbound/yolo</Property>      
        <Property name="Yarp Writing Port">/akd/outbound/yolo</Property>          
        <Property name="Yarp Log">../../var/log/SpikeStream_Unittest20_yolo_Yarp.log</Property>      
        <Property name="Buffer Log">../../var/log/SpikeStream_Unittest20_yolo_Buffer.log</Property>
      </Properties>
    </Reader>
    <NeuronGroup name="yolo"/>
  </InboundChannel>  


  <OutboundChannel name="WbActuator Outbound Channel">
    <Properties>
      <Property name="Actuator Prefix">vel</Property>              
      <Property name="Neuron Height" type="int">2</Property>

      <Property name="Max" type="double">3.5</Property>
      <Property name="Min" type="double">-3.5</Property>
      <Property name="Current Increment" type="double">0.5</Property>   <!-- 0.5 -->
      <Property name="Rate of Decay" type="double">0.1</Property>
      <Property name="Threshold" type="double">0.01</Property>
         
      <Property name="Coding Log">../../var/log/SpikeStream_Unittest20_vel_Coding.log</Property> 
      <Property name="Spikes Log">../../var/log/SpikeStream_Unittest20_vel_Spikes.log</Property>
       
    </Properties>
    <Writer name="Yarp WbActuator Writer" type="WbActuator Writer">
      <Properties>      
        <Property name="Yarp Writing Port">/cns/outbounde-puck2</Property>      
        <Property name="Yarp Reading Port">/e-puck2/actuators</Property>      
        <Property name="Yarp RPC Server Port">/e-puck2/supervisor</Property>      
        <Property name="Yarp RPC Client Port">/cns/client/epuck2/vel</Property>      
        <Property name="Yarp Log">../../var/log/SpikeStream_Unittest20_vel_Yarp.log</Property>      
        <Property name="Buffer Log">../../var/log/SpikeStream_Unittest20_vel_Buffer.log</Property>
      </Properties>
    </Writer>
    <NeuronGroup name="ctx.vel"/>
  </OutboundChannel>  
  
</CARLsimCNS>




